{
  "name": "rice-traceability-network",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "client": {
    "tlsEnable": true,
    "adminCredential": {
      "id": "exploreradmin",
      "password": "exploreradminpw"
    },
    "enableAuthentication": false,
    "organization": "Org1MSP",
    "discovery-as-localhost": false,
    "connection": {
      "timeout": {
        "peer": { "endorser": "300" },
        "orderer": "300"
      }
    }
  },
  "channels": {
    "mychannel": {
      "peers": ["peer0.org1.example.com", "peer0.org2.example.com"],
      "orderers": ["orderer.example.com"]
    }
  },
  "organizations": {
    "Org1MSP": {
      "mspid": "Org1MSP",
      "admin": {
        "id": "admin",
        "certificate": "/opt/explorer/app/platform/fabric/crypto/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/signcerts/Admin@org1.example.com-cert.pem",
        "private_key": "/opt/explorer/app/platform/fabric/crypto/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/keystore/priv_sk"
      },
      "signedCert": {
        "path": "/opt/explorer/app/platform/fabric/crypto/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/signcerts/Admin@org1.example.com-cert.pem"
      },
      "adminPrivateKey": {
        "path": "/opt/explorer/app/platform/fabric/crypto/peerOrganizations/org1.example.com/users/Admin@org1.example.com/msp/keystore/priv_sk"
      },
      "peers": ["peer0.org1.example.com"]
    },
    "Org2MSP": {
      "mspid": "Org2MSP",
      "admin": {
        "id": "admin",
        "certificate": "/opt/explorer/app/platform/fabric/crypto/peerOrganizations/org2.example.com/users/Admin@org2.example.com/msp/signcerts/Admin@org2.example.com-cert.pem",
        "private_key": "/opt/explorer/app/platform/fabric/crypto/peerOrganizations/org2.example.com/users/Admin@org2.example.com/msp/keystore/priv_sk"
      },
      "signedCert": {
        "path": "/opt/explorer/app/platform/fabric/crypto/peerOrganizations/org2.example.com/users/Admin@org2.example.com/msp/signcerts/Admin@org2.example.com-cert.pem"
      },
      "adminPrivateKey": {
        "path": "/opt/explorer/app/platform/fabric/crypto/peerOrganizations/org2.example.com/users/Admin@org2.example.com/msp/keystore/priv_sk"
      },
      "peers": ["peer0.org2.example.com"]
    }
  },
  "peers": {
    "peer0.org1.example.com": {
      "tlsCACerts": {
        "path": "/opt/explorer/app/platform/fabric/crypto/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt"
      },
      "url": "grpcs://peer0.org1.example.com:7051",
      "grpcOptions": {
        "ssl-target-name-override": "peer0.org1.example.com",
        "grpc.keepalive_time_ms": 120000,
        "grpc.keepalive_timeout_ms": 5000,
        "grpc.keepalive_permit_without_calls": 1,
        "grpc.http2.min_time_between_pings_ms": 10000
      }
    },
    "peer0.org2.example.com": {
      "tlsCACerts": {
        "path": "/opt/explorer/app/platform/fabric/crypto/peerOrganizations/org2.example.com/peers/peer0.org2.example.com/tls/ca.crt"
      },
      "url": "grpcs://peer0.org2.example.com:7052",
      "grpcOptions": {
        "ssl-target-name-override": "peer0.org2.example.com",
        "grpc.keepalive_time_ms": 120000,
        "grpc.keepalive_timeout_ms": 5000,
        "grpc.keepalive_permit_without_calls": 1,
        "grpc.http2.min_time_between_pings_ms": 10000
      }
    }
  },
  "orderers": {
    "orderer.example.com": {
      "tlsCACerts": {
        "path": "/opt/explorer/app/platform/fabric/crypto/ordererOrganizations/example.com/orderers/orderer.example.com/tls/ca.crt"
      },
      "url": "grpcs://orderer.example.com:7050",
      "grpcOptions": {
        "ssl-target-name-override": "orderer.example.com",
        "grpc.keepalive_time_ms": 120000,
        "grpc.keepalive_timeout_ms": 5000,
        "grpc.keepalive_permit_without_calls": 1,
        "grpc.http2.min_time_between_pings_ms": 10000
      }
    }
